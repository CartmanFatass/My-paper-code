{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_engineering_state",
  "title": "HMASD engineering state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "writer",
    "direction_id",
    "phase",
    "actionable",
    "blockers",
    "waiting_on",
    "scope_ref",
    "base_sha",
    "worktree_ref",
    "candidate_sha",
    "changed_paths",
    "verification_refs",
    "run_refs",
    "integration",
    "active_agents",
    "last_checkpoint_sha",
    "next_action"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1, 2] },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "pattern": "^CM-[a-z0-9][a-z0-9_-]{1,63}$" },
    "direction_id": { "$ref": "#/$defs/direction_id" },
    "phase": {
      "type": "string",
      "enum": [
        "UNREQUESTED",
        "SCOPING",
        "IMPLEMENTING",
        "VERIFYING",
        "RUN_READY",
        "RUNNING",
        "INTEGRATING",
        "WAITING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "actionable": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "waiting_on": { "type": "array", "items": { "$ref": "#/$defs/waiting" } },
    "scope_ref": { "$ref": "#/$defs/decision_ref" },
    "contract_ref": { "$ref": "#/$defs/ref" },
    "base_sha": { "$ref": "#/$defs/git_sha" },
    "worktree_ref": {
      "anyOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        { "type": "null" }
      ]
    },
    "candidate_sha": {
      "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
    },
    "changed_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "verification_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "run_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "engineering_status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "IMPLEMENTED", "UNCHANGED", "BLOCKED", "NOT_REACHED"]
    },
    "observation_status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "OBSERVED", "NOT_OBSERVED", "NOT_REQUIRED"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "SATISFIED", "UNSATISFIED", "NOT_RUN"]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_branch", "target_sha_seen", "integrated_sha"],
      "properties": {
        "target_branch": { "type": "string", "const": "omp/workflow" },
        "target_sha_seen": { "$ref": "#/$defs/git_sha" },
        "integrated_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        }
      }
    },
    "active_agents": { "type": "array", "items": { "$ref": "#/$defs/active_agent" } },
    "last_checkpoint_sha": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "next_action": { "$ref": "#/$defs/next_action" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "heading", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ref": {
      "anyOf": [
        { "$ref": "#/$defs/content_ref" },
        { "type": "string", "minLength": 1, "maxLength": 512 }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "observed_refs", "resume_condition_ref"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "observed_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "resume_condition_ref": {
          "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
        }
      }
    },
    "waiting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "expected_terminal_states"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "ref": { "$ref": "#/$defs/ref" },
        "expected_terminal_states": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" }
        }
      }
    },
    "active_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_identity", "generation", "assignment_id", "runtime_ref"],
      "properties": {
        "logical_identity": { "type": "string", "pattern": "^(?:Root|BrowserTransport|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63}|hmasd-(?:git-integration|project-scout|code-scout|implementer(?:-terra)?|reviewer|verifier|experiment-operator|research-(?:scout|innovator|critic|principles-analyst|artifact-writer)|workflow-recovery-manager)|librarian)$" },
        "generation": { "type": "integer", "minimum": 1 },
        "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "runtime_ref": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input_refs"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "owner": {
          "type": "string",
          "enum": ["ROOT", "EM", "CM", "TRANSPORT", "EXPERIMENT_OPERATOR", "USER"]
        },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
