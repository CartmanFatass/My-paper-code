{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_git_parallel_set",
  "title": "HMASD immutable Git parallel-set authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parallel_set_id", "common_epoch_sha", "target_branch", "remote", "directions"],
  "properties": {
    "schema": { "type": "string", "const": "hmasd.git-parallel-set/v1" },
    "parallel_set_id": { "$ref": "#/$defs/id" },
    "common_epoch_sha": { "$ref": "#/$defs/git_sha" },
    "target_branch": { "type": "string", "const": "omp/workflow" },
    "remote": { "$ref": "#/$defs/remote" },
    "directions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/direction" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "argv", "cwd"],
      "properties": {
        "check_id": { "$ref": "#/$defs/id" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": {
          "anyOf": [
            { "type": "string", "const": "" },
            { "$ref": "#/$defs/relative_path" }
          ]
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ref", "url_sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "ref": { "type": "string", "const": "refs/heads/omp/workflow" },
        "url_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_id",
        "assignment_id",
        "kind",
        "allowed_roots",
        "expected_changed_paths",
        "dependency_paths",
        "verification",
        "prospective_checks",
        "required_handoff_sha",
        "required_dependencies"
      ],
      "properties": {
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "assignment_id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["research", "engineering"] },
        "allowed_roots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relative_path" },
          "uniqueItems": true
        },
        "expected_changed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relative_path" },
          "uniqueItems": true
        },
        "dependency_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/relative_path" },
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_ref" },
          "uniqueItems": true
        },
        "prospective_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" },
          "uniqueItems": true
        },
        "required_handoff_sha": { "type": "null" },
        "required_dependencies": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
