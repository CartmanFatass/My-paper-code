{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_clerk_operation",
  "title": "HMASD immutable Clerk operation packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "operation_id",
    "clerk_assignment_id",
    "executor",
    "authorizer",
    "operation",
    "requires",
    "authority",
    "mutation",
    "effect",
    "target",
    "acceptance_refs",
    "postconditions",
    "stop_condition",
    "return_owner",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "clerk_operation" },
    "operation_id": { "$ref": "#/$defs/id" },
    "clerk_assignment_id": { "$ref": "#/$defs/clerk_assignment_id" },
    "executor": { "$ref": "#/$defs/executor" },
    "authorizer": { "$ref": "#/$defs/authorizer" },
    "operation": {
      "type": "string",
      "enum": [
        "STATE_CAS",
        "WORKTREE_PROVISION",
        "WORKTREE_INSPECT",
        "WORKTREE_RELEASE",
        "PATCH_APPLY",
        "CANDIDATE_CREATE",
        "GIT_RECORD",
        "GIT_PREPARE",
        "GIT_INTEGRATE_PUSH"
      ]
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_dependency" }
    },
    "authority": { "$ref": "#/$defs/authority" },
    "mutation": {
      "oneOf": [
        { "$ref": "#/$defs/read_only_mutation" },
        { "$ref": "#/$defs/state_path_mutation" },
        { "$ref": "#/$defs/worktree_content_mutation" },
        { "$ref": "#/$defs/worktree_registry_mutation" },
        { "$ref": "#/$defs/git_target_mutation" }
      ]
    },
    "effect": { "$ref": "#/$defs/effect" },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/state_cas_target" },
        { "$ref": "#/$defs/worktree_provision_target" },
        { "$ref": "#/$defs/worktree_inspect_target" },
        { "$ref": "#/$defs/worktree_release_target" },
        { "$ref": "#/$defs/patch_apply_target" },
        { "$ref": "#/$defs/candidate_create_target" },
        { "$ref": "#/$defs/git_record_target" },
        { "$ref": "#/$defs/git_prepare_target" },
        { "$ref": "#/$defs/git_integrate_push_target" }
      ]
    },
    "acceptance_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_ref" }
    },
    "postconditions": { "$ref": "#/$defs/postconditions" },
    "stop_condition": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "return_owner": { "const": "ROOT" },
    "packet_sha256": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    {
      "properties": {
        "operation": { "const": "STATE_CAS" },
        "mutation": { "$ref": "#/$defs/state_path_mutation" },
        "effect": { "$ref": "#/$defs/state_cas_effect" },
        "target": { "$ref": "#/$defs/state_cas_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "WORKTREE_PROVISION" },
        "mutation": { "$ref": "#/$defs/worktree_registry_mutation" },
        "effect": { "$ref": "#/$defs/worktree_provision_effect" },
        "target": { "$ref": "#/$defs/worktree_provision_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "WORKTREE_INSPECT" },
        "mutation": { "$ref": "#/$defs/read_only_mutation" },
        "effect": { "$ref": "#/$defs/worktree_inspect_effect" },
        "target": { "$ref": "#/$defs/worktree_inspect_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "WORKTREE_RELEASE" },
        "mutation": { "$ref": "#/$defs/worktree_registry_mutation" },
        "effect": { "$ref": "#/$defs/worktree_release_effect" },
        "target": { "$ref": "#/$defs/worktree_release_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "PATCH_APPLY" },
        "mutation": { "$ref": "#/$defs/worktree_content_mutation" },
        "effect": { "$ref": "#/$defs/patch_apply_effect" },
        "target": { "$ref": "#/$defs/patch_apply_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "CANDIDATE_CREATE" },
        "mutation": { "$ref": "#/$defs/worktree_content_mutation" },
        "effect": { "$ref": "#/$defs/candidate_create_effect" },
        "target": { "$ref": "#/$defs/candidate_create_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "GIT_RECORD" },
        "mutation": { "$ref": "#/$defs/worktree_registry_mutation" },
        "effect": { "$ref": "#/$defs/git_record_effect" },
        "target": { "$ref": "#/$defs/git_record_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "GIT_PREPARE" },
        "mutation": { "$ref": "#/$defs/worktree_registry_mutation" },
        "effect": { "$ref": "#/$defs/git_prepare_effect" },
        "target": { "$ref": "#/$defs/git_prepare_target" }
      }
    },
    {
      "properties": {
        "operation": { "const": "GIT_INTEGRATE_PUSH" },
        "mutation": { "$ref": "#/$defs/git_target_mutation" },
        "effect": { "$ref": "#/$defs/git_integrate_push_effect" },
        "target": { "$ref": "#/$defs/git_integrate_push_target" }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "clerk_assignment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "direction_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "git_ref": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullable_content_ref": {
      "anyOf": [
        { "$ref": "#/$defs/content_ref" },
        { "type": "null" }
      ]
    },
    "node_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_identity", "generation", "assignment_id"],
      "properties": {
        "logical_identity": {
          "type": "string",
          "pattern": "^(?:Root|Clerk-[a-z0-9][a-z0-9-]{1,127}|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63}|BrowserTransport|hmasd-[a-z0-9-]+|librarian)$"
        },
        "generation": { "type": "integer", "minimum": 1 },
        "assignment_id": { "$ref": "#/$defs/id" }
      }
    },
    "producer_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "result_sha256",
        "required_status",
        "required_payload_kind",
        "required_refs"
      ],
      "properties": {
        "producer": { "$ref": "#/$defs/node_key" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "required_status": {
          "type": "string",
          "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "FAILED"]
        },
        "required_payload_kind": {
          "type": "string",
          "enum": [
            "root",
            "git",
            "portfolio",
            "em",
            "cm",
            "implementation",
            "review",
            "verification",
            "run",
            "transport",
            "artifact",
            "recovery",
            "clerk"
          ]
        },
        "required_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_ref" }
        }
      }
    },
    "authority_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_ref", "revision_or_checkpoint"],
      "properties": {
        "authority_ref": { "$ref": "#/$defs/content_ref" },
        "revision_or_checkpoint": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "$ref": "#/$defs/git_sha" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "exact_dependency": {
      "oneOf": [
        { "$ref": "#/$defs/producer_dependency" },
        { "$ref": "#/$defs/authority_dependency" }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "logical_identity", "generation"],
      "properties": {
        "role": { "const": "hmasd-clerk" },
        "logical_identity": {
          "type": "string",
          "pattern": "^Clerk-[a-z0-9][a-z0-9-]{1,127}$"
        },
        "generation": { "type": "integer", "minimum": 1 }
      }
    },
    "authorizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "logical_identity", "generation", "assignment_id"],
      "properties": {
        "role": { "type": "string", "enum": ["root", "hmasd-em", "hmasd-cm"] },
        "logical_identity": {
          "type": "string",
          "pattern": "^(?:Root|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63})$"
        },
        "generation": { "type": "integer", "minimum": 1 },
        "assignment_id": { "$ref": "#/$defs/id" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction_id", "document_writer", "git_actor", "worktree_kind", "assignment_authority"],
      "properties": {
        "direction_id": {
          "anyOf": [
            { "$ref": "#/$defs/direction_id" },
            { "type": "null" }
          ]
        },
        "document_writer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:Portfolio|Root|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63})$"
            },
            { "type": "null" }
          ]
        },
        "git_actor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:root|em:[a-z0-9][a-z0-9_-]{1,63}|cm:[a-z0-9][a-z0-9_-]{1,63})$"
            },
            { "type": "null" }
          ]
        },
        "worktree_kind": {
          "type": ["string", "null"],
          "enum": ["research", "engineering", null]
        },
        "assignment_authority": {
          "type": "string",
          "enum": ["DIRECTION", "SHARED", "RECOVERY"]
        }
      }
    },
    "mutation_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["STATE_PATH", "RUNTIME_WORKTREES_STATE", "WORKTREE", "CONTAINER", "GIT_TARGET", "REMOTE_TARGET"]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "read_only_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources"],
      "properties": {
        "class": { "const": "READ_ONLY" },
        "resources": { "const": [] }
      }
    },
    "state_path_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources"],
      "properties": {
        "class": { "const": "STATE_PATH" },
        "resources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation_resource" } }
      }
    },
    "worktree_content_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources"],
      "properties": {
        "class": { "const": "WORKTREE_CONTENT" },
        "resources": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation_resource" } }
      }
    },
    "worktree_registry_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources"],
      "properties": {
        "class": { "const": "WORKTREE_REGISTRY" },
        "resources": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation_resource" } }
      }
    },
    "git_target_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "resources"],
      "properties": {
        "class": { "const": "GIT_TARGET" },
        "resources": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation_resource" } }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STATE_CAS",
              "WORKTREE_PROVISION",
              "WORKTREE_RELEASE",
              "PATCH_APPLY",
              "CANDIDATE_CREATE",
              "GIT_RECORD",
              "GIT_PREPARE",
              "GIT_INTEGRATE_PUSH"
            ]
          }
        },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "state_cas_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["STATE_CAS"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "worktree_provision_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["WORKTREE_PROVISION"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "worktree_inspect_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": [] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "worktree_release_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["WORKTREE_RELEASE"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "patch_apply_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["PATCH_APPLY"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "candidate_create_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["CANDIDATE_CREATE"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "git_record_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["GIT_RECORD"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "git_prepare_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["GIT_PREPARE"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "git_integrate_push_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "attempt_token", "authorized_effects", "unknown_outcome"],
      "properties": {
        "attempt": { "type": "integer", "const": 1 },
        "attempt_token": { "$ref": "#/$defs/sha256" },
        "authorized_effects": { "const": ["GIT_INTEGRATE_PUSH"] },
        "unknown_outcome": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "postconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "refusal", "unknown"],
      "properties": {
        "success": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "refusal": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "unknown": { "const": "OBSERVE_ONLY_NO_AUTOMATIC_RETRY" }
      }
    },
    "mutation_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager_assignment_id", "clerk_assignment_id", "handoff_ref", "lease_token"],
      "properties": {
        "manager_assignment_id": { "$ref": "#/$defs/id" },
        "clerk_assignment_id": { "$ref": "#/$defs/clerk_assignment_id" },
        "handoff_ref": { "$ref": "#/$defs/content_ref" },
        "lease_token": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_sha"],
          "properties": {
            "candidate_sha": { "$ref": "#/$defs/git_sha" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_binding"],
          "properties": {
            "receipt_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation_id", "receipt_sha256", "output_field"],
              "properties": {
                "operation_id": { "$ref": "#/$defs/id" },
                "receipt_sha256": { "$ref": "#/$defs/sha256" },
                "output_field": { "const": "candidate_sha" }
              }
            }
          }
        }
      ]
    },
    "prior_operation_receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "receipt_sha256", "output_field"],
          "properties": {
            "operation_id": { "$ref": "#/$defs/id" },
            "receipt_sha256": { "$ref": "#/$defs/sha256" },
            "output_field": {
              "type": "string",
              "enum": ["registry_revision", "result_tree_sha", "candidate_sha", "receipt_ref", "integrated_sha", "status"]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "state_cas_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_kind", "canonical_target_path", "expected_revision", "input_ref", "expected_document_writer"],
      "properties": {
        "state_kind": {
          "type": "string",
          "enum": ["portfolio_registry", "research_state", "engineering_state", "run_manifest", "accepted_result", "runtime_agents"]
        },
        "canonical_target_path": { "$ref": "#/$defs/absolute_path" },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "input_ref": { "$ref": "#/$defs/content_ref" },
        "expected_document_writer": {
          "type": "string",
          "pattern": "^(?:Portfolio|Root|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63}|hmasd-experiment-operator)$"
        }
      }
    },
    "worktree_provision_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_repo_path", "canonical_container_path", "canonical_worktree_path", "worktree_ref", "direction_id", "worktree_kind", "base_sha", "integration_policy", "parallel_set_manifest_ref", "expected_registry_revision", "expected_lifecycle", "expected_receipt_sha256", "required_handoff_sha", "required_dependency_refs", "prior_operation_receipt", "mutation_lease"],
      "properties": {
        "canonical_repo_path": { "$ref": "#/$defs/absolute_path" },
        "canonical_container_path": { "$ref": "#/$defs/absolute_path" },
        "canonical_worktree_path": { "$ref": "#/$defs/absolute_path" },
        "worktree_ref": { "$ref": "#/$defs/id" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "worktree_kind": { "type": "string", "enum": ["research", "engineering"] },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "integration_policy": { "$ref": "#/$defs/git_policy" },
        "parallel_set_manifest_ref": { "$ref": "#/$defs/nullable_content_ref" },
        "expected_registry_revision": { "type": "integer", "minimum": 1 },
