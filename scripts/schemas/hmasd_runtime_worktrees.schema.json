{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_runtime_worktrees",
  "title": "HMASD runtime worktree registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "writer", "worktrees"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "const": "Root" },
    "worktrees": { "type": "array", "items": { "$ref": "#/$defs/current_worktree" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "mutation_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager_assignment_id", "clerk_assignment_id", "handoff_ref", "lease_token"],
      "properties": {
        "manager_assignment_id": { "$ref": "#/$defs/id" },
        "clerk_assignment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
        "handoff_ref": { "$ref": "#/$defs/content_ref" },
        "lease_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "parallel_set_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "parallel_set_id", "common_epoch_sha"],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/relative_path" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parallel_set_id": { "$ref": "#/$defs/id" },
        "common_epoch_sha": { "$ref": "#/$defs/git_sha" }
      }
    },
    "unknown_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha",
        "worktree_exists",
        "registration_count",
        "registration_branch",
        "registration_head",
        "branch_sha"
      ],
      "properties": {
        "target_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "worktree_exists": { "type": "boolean" },
        "registration_count": { "type": "integer", "minimum": 0 },
        "registration_branch": { "anyOf": [{ "type": "string", "pattern": "^refs/heads/omp/" }, { "type": "null" }] },
        "registration_head": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "branch_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] }
      }
    },
    "unknown_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "status",
        "recorded_at",
        "error",
        "registry_revision_before",
        "registry_revision_observed",
        "observation"
      ],
      "properties": {
        "operation": { "type": "string", "enum": ["APPLY", "RELEASE"] },
        "status": { "type": "string", "const": "UNKNOWN" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "error": { "type": "string", "minLength": 1 },
        "registry_revision_before": { "type": "integer", "minimum": 1 },
        "registry_revision_observed": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "observation": { "$ref": "#/$defs/unknown_observation" }
      }
    },
    "current_worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_ref",
        "direction_id",
        "kind",
        "assignment_id",
        "canonical_absolute_path",
        "branch",
        "base_sha",
        "candidate_sha",
        "integrated_sha",
        "integration_policy",
        "parallel_set_authorization",
        "required_handoff_sha",
        "required_dependency_refs",
        "mutation_lease",
        "lifecycle",
        "receipt_path",
        "operation_token"
      ],
      "properties": {
        "worktree_ref": { "$ref": "#/$defs/id" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "kind": { "type": "string", "enum": ["research", "engineering"] },
        "assignment_id": { "$ref": "#/$defs/id" },
        "writer_phase": { "type": "string", "enum": ["EM", "CM"] },
        "handoff_ref": {
          "anyOf": [{ "$ref": "#/$defs/relative_path" }, { "type": "null" }]
        },
        "canonical_absolute_path": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$" },
        "branch": { "type": "string", "pattern": "^omp/[a-z0-9][a-z0-9_-]{1,63}/(?:research|engineering)/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "candidate_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "integrated_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "integration_policy": {
          "type": "string",
          "enum": ["EXACT_HANDOFF", "ORTHOGONAL_DIRECTION"]
        },
        "parallel_set_authorization": {
          "anyOf": [{ "$ref": "#/$defs/parallel_set_authorization" }, { "type": "null" }]
        },
        "required_handoff_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        },
        "required_dependency_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_ref" }
        },
        "mutation_lease": {
          "anyOf": [{ "$ref": "#/$defs/mutation_lease" }, { "type": "null" }]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "PROVISIONING",
            "PROVISIONED",
            "READY",
            "INSPECTED",
            "PATCHED",
            "CANDIDATE_READY",
            "PREPARED",
            "PREPARED_FOR_INTEGRATION",
            "INTEGRATED",
            "BLOCKED",
            "UNKNOWN",
            "APPLY_OUTCOME_UNKNOWN",
            "RELEASE_OUTCOME_UNKNOWN",
            "RELEASED",
            "RETAINED_FOR_RECOVERY"
          ]
        },
        "receipt_path": { "$ref": "#/$defs/relative_path" },
        "operation_token": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "unknown_outcome": {
          "anyOf": [{ "$ref": "#/$defs/unknown_outcome" }, { "type": "null" }]
        }
      }
    }
  }
}
