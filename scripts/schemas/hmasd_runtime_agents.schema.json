{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_runtime_agents",
  "title": "HMASD runtime agent registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "writer", "agents"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "const": "Root" },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identity": {
      "type": "string",
      "pattern": "^(?:Root|Portfolio|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63})$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_identity",
        "agent_type",
        "generation",
        "parent_identity",
        "session_ref",
        "job_ref",
        "runtime_ref",
        "lifecycle",
        "last_seen_at"
      ],
      "properties": {
        "logical_identity": { "$ref": "#/$defs/identity" },
        "agent_type": { "type": "string", "pattern": "^(?:hmasd-[a-z0-9-]+|task|librarian)$" },
        "generation": { "type": "integer", "minimum": 1 },
        "parent_identity": { "$ref": "#/$defs/identity" },
        "session_ref": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "job_ref": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "runtime_ref": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "lifecycle": {
          "type": "string",
          "enum": ["CREATED", "RUNNING", "PARKED", "IDLE", "COMPLETED", "FAILED", "RETIRED"]
        },
        "last_seen_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
