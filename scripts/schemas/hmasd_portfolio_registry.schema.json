{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_portfolio_registry",
  "title": "HMASD portfolio registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "writer",
    "workflow_version",
    "goal",
    "directions"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "const": "Portfolio" },
    "workflow_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "goal": { "$ref": "#/$defs/content_ref" },
    "directions": {
      "type": "array",
      "items": { "$ref": "#/$defs/direction" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "heading", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "abbreviation",
        "path",
        "lifecycle",
        "dependencies",
        "lifecycle_decision_ref",
        "reactivation_condition_ref",
        "agent",
        "research_state_path",
        "engineering_state_path",
        "external_review_index_path"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/direction_id" },
        "abbreviation": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "path": { "$ref": "#/$defs/path" },
        "lifecycle": { "type": "string", "enum": ["REGISTERED", "ACTIVE", "PARKED", "CLOSED"] },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/direction_id" }
        },
        "lifecycle_decision_ref": { "$ref": "#/$defs/decision_ref" },
        "reactivation_condition_ref": {
          "anyOf": [{ "$ref": "#/$defs/decision_ref" }, { "type": "null" }]
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_identity", "job_name", "generation", "runtime_ref"],
          "properties": {
            "logical_identity": { "type": "string", "pattern": "^EM-[a-z0-9][a-z0-9_-]{1,63}$" },
            "job_name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "generation": { "type": "integer", "minimum": 1 },
            "runtime_ref": {
              "anyOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
                { "type": "null" }
              ]
            }
          }
        },
        "research_state_path": { "$ref": "#/$defs/path" },
        "engineering_state_path": { "$ref": "#/$defs/path" },
        "external_review_index_path": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle": { "const": "PARKED" } },
            "required": ["lifecycle"]
          },
          "then": {
            "properties": {
              "reactivation_condition_ref": { "$ref": "#/$defs/decision_ref" }
            }
          }
        }
      ]
    }
  }
}
