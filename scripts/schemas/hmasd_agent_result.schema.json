{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_agent_result",
  "title": "HMASD common agent result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "logical_identity",
    "generation",
    "assignment_id",
    "status",
    "materiality",
    "summary",
    "changed_paths",
    "state_refs",
    "artifact_refs",
    "checkpoint_sha",
    "decision_requests",
    "next_action",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "role": {
      "type": "string",
      "pattern": "^(?:root|librarian|hmasd-(?:portfolio|em|cm|git-integration|project-scout|code-scout|implementer(?:-terra)?|reviewer|verifier|experiment-operator|research-(?:scout|innovator|critic|principles-analyst|artifact-writer)|external-(?:pro|gemini)-transport|workflow-recovery-manager))$"
    },
    "logical_identity": { "$ref": "#/$defs/logical_identity" },
    "generation": { "type": "integer", "minimum": 1 },
    "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "type": "string", "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "FAILED"] },
    "materiality": { "type": "string", "enum": ["NONE", "LOCAL", "DIRECTION", "PORTFOLIO", "USER"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "state_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } },
    "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } },
    "checkpoint_sha": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "decision_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_request" }
    },
    "next_action": {
      "anyOf": [{ "$ref": "#/$defs/next_action" }, { "type": "null" }]
    },
    "failure_scope": {
      "anyOf": [
        { "type": "string", "enum": ["project", "direction", "feature", "effect"] },
        { "type": "null" }
      ]
    },
    "failure_ref": { "$ref": "#/$defs/nullable_ref" },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/root_payload" },
        { "$ref": "#/$defs/git_payload" },
        { "$ref": "#/$defs/portfolio_payload" },
        { "$ref": "#/$defs/em_payload" },
        { "$ref": "#/$defs/cm_payload" },
        { "$ref": "#/$defs/implementation_payload" },
        { "$ref": "#/$defs/review_payload" },
        { "$ref": "#/$defs/verification_payload" },
        { "$ref": "#/$defs/run_payload" },
        { "$ref": "#/$defs/transport_payload" },
        { "$ref": "#/$defs/artifact_payload" },
        { "$ref": "#/$defs/recovery_payload" }
      ]
    }
  },
  "$defs": {
    "logical_identity": {
      "type": "string",
      "pattern": "^(?:Root|Portfolio|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63}|hmasd-(?:project-scout|code-scout|implementer(?:-terra)?|reviewer|verifier|experiment-operator|research-(?:scout|innovator|critic|principles-analyst|artifact-writer)|external-(?:pro|gemini)-transport|workflow-recovery-manager)|librarian)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!.*:)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![^/]*[. ](?:/|$))(?!.*\\/[^/]*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        { "type": "string", "minLength": 1, "maxLength": 512 }
      ]
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullable_ref": {
      "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "nullable_file_ref": {
      "anyOf": [{ "$ref": "#/$defs/file_ref" }, { "type": "null" }]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["USER_APPROVAL", "USER_DECISION", "USER_BOUNDARY"] },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input_refs"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "payload_base": {
      "type": "object",
      "additionalProperties": false
    },
    "root_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wake_reason"],
      "properties": {
        "kind": { "const": "root" },
        "wake_reason": {
          "type": "string",
          "enum": ["startup", "resume", "completion", "file-change", "compaction"]
        }
      }
    },
    "git_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction_id",
        "base_sha",
        "candidate_sha",
        "integrated_sha",
        "changed_paths"
      ],
      "properties": {
        "kind": { "const": "git" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "candidate_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        },
        "integrated_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      }
    },
    "portfolio_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction_actions", "portfolio_ref", "registry_revision"],
      "properties": {
        "kind": { "const": "portfolio" },
        "direction_actions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "portfolio_ref": { "$ref": "#/$defs/file_ref" },
        "registry_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "em_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction_id", "question_sha256", "evidence_set_sha256", "conclusion_refs", "engineering_request_ref"],
      "properties": {
        "kind": { "const": "em" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "question_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_set_sha256": { "$ref": "#/$defs/sha256" },
        "conclusion_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } },
        "engineering_request_ref": { "$ref": "#/$defs/nullable_file_ref" }
      }
    },
    "cm_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction_id", "scope_ref", "base_sha", "candidate_sha", "verification_refs", "integrated_sha"],
      "properties": {
        "kind": { "const": "cm" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "scope_ref": { "$ref": "#/$defs/file_ref" },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "candidate_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "verification_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } },
        "integrated_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] }
      }
    },
    "implementation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "changed_paths", "preserved_invariants", "lsp_evidence_refs"],
      "properties": {
        "kind": { "const": "implementation" },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "preserved_invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lsp_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } }
      }
    },
    "review_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "findings", "evidence_refs"],
      "properties": {
        "kind": { "const": "review" },
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } }
      }
    },
    "verification_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checks", "behavioral_evidence_refs", "benchmark_refs"],
      "properties": {
        "kind": { "const": "verification" },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "behavioral_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } },
        "benchmark_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } }
      }
    },
    "run_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "manifest_ref", "terminal_status", "exit_code"],
      "properties": {
        "kind": { "const": "run" },
        "run_id": { "$ref": "#/$defs/id" },
        "manifest_ref": { "$ref": "#/$defs/file_ref" },
        "terminal_status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "transport_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "mode", "round_id", "operation_ref", "archive_ref", "handoff_ref"],
      "properties": {
        "kind": { "const": "transport" },
        "provider": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["DIVERGENT", "CONVERGENCE", "MONITOR"] },
        "round_id": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
        "operation_ref": { "$ref": "#/$defs/ref" },
        "archive_ref": { "$ref": "#/$defs/nullable_file_ref" },
        "handoff_ref": { "$ref": "#/$defs/nullable_file_ref" }
      }
    },
    "artifact_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_refs"],
      "properties": {
        "kind": { "const": "artifact" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/file_ref" } }
      }
    },
    "recovery_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "failure_class", "observed_refs", "attempts", "outcome", "resume_condition"],
      "properties": {
        "kind": { "const": "recovery" },
        "failure_class": { "type": "string", "minLength": 1 },
        "observed_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "attempts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "outcome": { "type": "string", "minLength": 1 },
        "resume_condition": { "$ref": "#/$defs/nullable_ref" }
      }
    }
  }
}
