{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_agent_result",
  "title": "HMASD common agent result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "logical_identity",
    "generation",
    "assignment_id",
    "status",
    "materiality",
    "summary",
    "changed_paths",
    "state_refs",
    "artifact_refs",
    "checkpoint_sha",
    "decision_requests",
    "next_actions",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "role": {
      "type": "string",
      "pattern": "^(?:root|librarian|hmasd-(?:em|cm|clerk|browser-transport|git-integration|project-scout|code-scout|implementer(?:-terra)?|reviewer|verifier|experiment-operator|research-(?:scout|innovator|critic|principles-analyst|artifact-writer)|workflow-recovery-manager))$"
    },
    "logical_identity": { "$ref": "#/$defs/logical_identity" },
    "generation": { "type": "integer", "minimum": 1 },
    "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "type": "string", "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "FAILED"] },
    "materiality": { "type": "string", "enum": ["NONE", "LOCAL", "DIRECTION", "PORTFOLIO", "USER"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "state_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "checkpoint_sha": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "decision_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_request" }
    },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/root_payload" },
        { "$ref": "#/$defs/git_payload" },
        { "$ref": "#/$defs/portfolio_payload" },
        { "$ref": "#/$defs/em_payload" },
        { "$ref": "#/$defs/cm_payload" },
        { "$ref": "#/$defs/implementation_payload" },
        { "$ref": "#/$defs/review_payload" },
        { "$ref": "#/$defs/verification_payload" },
        { "$ref": "#/$defs/run_payload" },
        { "$ref": "#/$defs/transport_payload" },
        { "$ref": "#/$defs/artifact_payload" },
        { "$ref": "#/$defs/recovery_payload" },
        { "$ref": "#/$defs/clerk_payload" }
      ]
    }
  },
  "$defs": {
    "logical_identity": {
      "type": "string",
      "pattern": "^(?:Root|BrowserTransport|Clerk|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63}|hmasd-(?:project-scout|code-scout|implementer(?:-terra)?|reviewer|verifier|experiment-operator|research-(?:scout|innovator|critic|principles-analyst|artifact-writer)|workflow-recovery-manager)|librarian)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        { "type": "string", "minLength": 1, "maxLength": 512 }
      ]
    },
    "nullable_ref": {
      "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "requester_identity": {
      "type": "string",
      "pattern": "^(?:Root|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63})$"
    },
    "transport_identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "nullable_transport_identity": {
      "anyOf": [{ "$ref": "#/$defs/transport_identity" }, { "type": "null" }]
    },
    "transport_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locus", "code"],
      "properties": {
        "locus": {
          "type": "string",
          "enum": ["NONE", "SPEC", "AUTH", "TAB_OWNERSHIP", "PRECOMMIT_UI", "COMMIT_BOUNDARY", "TURN_CONFIRMATION", "RESPONSE", "ARCHIVE"]
        },
        "code": { "type": "string", "pattern": "^(?:NONE|[A-Z][A-Z0-9_]{0,127})$" }
      },
      "allOf": [
        {
          "if": { "properties": { "locus": { "const": "NONE" } }, "required": ["locus"] },
          "then": { "properties": { "code": { "const": "NONE" } } },
          "else": { "properties": { "code": { "not": { "const": "NONE" } } } }
        }
      ]
    },
    "decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["USER_APPROVAL", "USER_DECISION", "USER_BOUNDARY"] },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "node_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_identity", "generation", "assignment_id"],
      "properties": {
        "logical_identity": { "$ref": "#/$defs/logical_identity" },
        "generation": { "type": "integer", "minimum": 1 },
        "assignment_id": { "$ref": "#/$defs/id" }
      }
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "result_sha256", "required_status", "required_payload_kind", "required_refs"],
      "properties": {
        "producer": { "$ref": "#/$defs/node_key" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "required_status": {
          "type": "string",
          "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "FAILED"]
        },
        "required_payload_kind": {
          "type": "string",
          "enum": ["root", "git", "portfolio", "em", "cm", "implementation", "review", "verification", "run", "transport", "artifact", "recovery", "clerk"]
        },
        "required_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_ref" }
        }
      }
    },
    "authority_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_ref", "revision_or_checkpoint"],
      "properties": {
        "authority_ref": { "$ref": "#/$defs/content_ref" },
        "revision_or_checkpoint": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "$ref": "#/$defs/git_sha" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "exact_dependency": {
      "oneOf": [
        { "$ref": "#/$defs/producer_dependency" },
        { "$ref": "#/$defs/authority_dependency" }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "owner", "input_refs", "dependencies", "authorized_effect_ref", "stop_or_reentry_ref"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "owner": {
          "type": "string",
          "enum": ["ROOT", "EM", "CM", "CLERK", "TRANSPORT", "EXPERIMENT_OPERATOR", "USER"]
        },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/exact_dependency" }
        },
        "authorized_effect_ref": { "$ref": "#/$defs/nullable_ref" },
        "stop_or_reentry_ref": { "$ref": "#/$defs/nullable_ref" }
      }
    },
    "payload_base": {
      "type": "object",
      "additionalProperties": false
    },
    "root_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wake_reason"],
      "properties": {
        "kind": { "const": "root" },
        "wake_reason": {
          "type": "string",
          "enum": ["startup", "resume", "completion", "file-change", "compaction"]
        }
      }
    },
    "git_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction_id",
        "actor",
        "base_sha",
        "candidate_sha",
        "integrated_sha",
        "changed_paths"
      ],
      "properties": {
        "kind": { "const": "git" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "actor": {
          "type": "string",
          "pattern": "^(?:root|em:[a-z0-9][a-z0-9_-]{1,63}|cm:[a-z0-9][a-z0-9_-]{1,63})$"
        },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "candidate_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        },
        "integrated_sha": {
          "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }]
        },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      }
    },
    "portfolio_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction_actions", "capacity_action", "portfolio_ref", "registry_revision"],
      "properties": {
        "kind": { "const": "portfolio" },
        "direction_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/direction_action" }
        },
        "capacity_action": { "$ref": "#/$defs/capacity_action" },
        "portfolio_ref": { "$ref": "#/$defs/ref" },
        "registry_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "direction_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction_id", "action", "decision_ref"],
      "properties": {
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "action": {
          "type": "string",
          "enum": ["NONE", "ACTIVATE", "CONTINUE", "NARROW", "PARK", "CLOSE", "FUSE", "SPINOFF"]
        },
        "decision_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "capacity_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "direction_id", "decision_ref"],
      "properties": {
        "action": { "type": "string", "enum": ["NONE", "REFILL"] },
        "direction_id": {
          "anyOf": [{ "$ref": "#/$defs/direction_id" }, { "type": "null" }]
        },
        "decision_ref": { "$ref": "#/$defs/nullable_ref" }
      }
    },
    "em_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction_id", "question_sha256", "evidence_set_sha256", "conclusion_refs", "engineering_request_ref", "semantic_product_ref", "persistence_status", "durable_state_ref", "candidate_sha", "integrated_sha"],
      "properties": {
        "kind": { "const": "em" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "cycle_id": { "$ref": "#/$defs/id" },
        "cycle_boundary": {
          "type": "string",
          "enum": ["FRESH_MATERIAL_CYCLE", "CONTINUATION", "CM_RESULT_INTERPRETATION", "EVIDENCE_INTAKE", "TERMINAL_GAP_DISPOSITION"]
        },
        "question_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_set_sha256": { "$ref": "#/$defs/sha256" },
        "scope_ref": { "$ref": "#/$defs/nullable_ref" },
        "synthesis_ref": { "$ref": "#/$defs/nullable_ref" },
        "claim_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "recommendation_ref": { "$ref": "#/$defs/nullable_ref" },
        "transport_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "conclusion_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "engineering_request_ref": { "$ref": "#/$defs/nullable_ref" },
        "semantic_product_ref": { "$ref": "#/$defs/ref" },
        "persistence_status": {
          "type": "string",
          "enum": ["PREPARED", "PERSISTED", "INTEGRATED"]
        },
        "durable_state_ref": { "$ref": "#/$defs/nullable_ref" },
        "candidate_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "integrated_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] }
      }
    },
    "cm_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction_id",
        "contract_ref",
        "scope_ref",
        "base_sha",
        "candidate_sha",
        "engineering_status",
        "observation_status",
        "verification_status",
        "verification_refs",
        "integrated_sha",
        "semantic_product_ref",
        "persistence_status",
        "durable_state_ref"
      ],
      "properties": {
        "kind": { "const": "cm" },
        "direction_id": { "$ref": "#/$defs/direction_id" },
        "contract_ref": { "$ref": "#/$defs/ref" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "base_sha": { "$ref": "#/$defs/git_sha" },
        "candidate_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "engineering_status": {
          "type": "string",
          "enum": ["IN_PROGRESS", "IMPLEMENTED", "UNCHANGED", "BLOCKED", "NOT_REACHED"]
        },
        "observation_status": {
          "type": "string",
          "enum": ["IN_PROGRESS", "OBSERVED", "NOT_OBSERVED", "NOT_REQUIRED"]
        },
        "verification_status": {
          "type": "string",
          "enum": ["IN_PROGRESS", "SATISFIED", "UNSATISFIED", "NOT_RUN"]
        },
        "verification_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "integrated_sha": { "anyOf": [{ "$ref": "#/$defs/git_sha" }, { "type": "null" }] },
        "semantic_product_ref": { "$ref": "#/$defs/ref" },
        "persistence_status": {
          "type": "string",
          "enum": ["PREPARED", "PERSISTED", "INTEGRATED"]
        },
        "durable_state_ref": { "$ref": "#/$defs/nullable_ref" }
      }
    },
    "implementation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "changed_paths", "preserved_invariants", "lsp_evidence_refs"],
      "properties": {
        "kind": { "const": "implementation" },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "preserved_invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lsp_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "review_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "findings", "evidence_refs"],
      "properties": {
        "kind": { "const": "review" },
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "verification_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checks", "behavioral_evidence_refs", "benchmark_refs"],
      "properties": {
        "kind": { "const": "verification" },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "behavioral_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "benchmark_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "run_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "manifest_ref", "terminal_status", "exit_code"],
      "properties": {
        "kind": { "const": "run" },
        "run_id": { "$ref": "#/$defs/id" },
        "manifest_ref": { "$ref": "#/$defs/ref" },
        "terminal_status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "transport_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "browser_identity",
        "transport_assignment",
        "requester",
        "provider",
        "product_model",
        "reasoning_effort",
        "mode",
        "effect_ref",
        "operation_id",
        "idempotency_key",
        "operation_ref",
        "provider_conversation_ref",
        "provider_conversation_id",
        "browser_tab_ref",
        "phase",
        "commitment",
        "recoverability",
        "observability",
        "message_capability",
        "failure",
        "provider_user_message_count",
        "send_activation_count",
        "user_message_id",
        "assistant_message_id",
        "archive_ref",
        "handoff_ref"
      ],
      "properties": {
        "kind": { "const": "transport" },
        "browser_identity": { "const": "BrowserTransport" },
        "transport_assignment": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requester": { "$ref": "#/$defs/requester_identity" },
        "provider": { "type": "string", "enum": ["chatgpt", "gemini"] },
        "product_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reasoning_effort": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["INNOVATOR", "CONVERGENCE", "DIVERGENT", "ENGINEERING", "MONITOR"]
        },
        "effect_ref": { "$ref": "#/$defs/nullable_ref" },
        "operation_id": { "$ref": "#/$defs/transport_identity" },
        "idempotency_key": { "$ref": "#/$defs/transport_identity" },
        "operation_ref": { "$ref": "#/$defs/ref" },
        "provider_conversation_ref": { "$ref": "#/$defs/nullable_ref" },
        "provider_conversation_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "browser_tab_ref": { "$ref": "#/$defs/nullable_ref" },
        "phase": {
          "type": "string",
          "enum": ["VALIDATE", "PREPARE_UI", "ARMED", "VERIFY_COMMITMENT", "WAIT_RESPONSE", "READ_RESPONSE", "PUBLISH_ARCHIVE", "TERMINAL"]
        },
        "commitment": {
          "type": "string",
          "enum": ["ZERO_PROVEN", "UNRESOLVED", "ONE_EXACT", "VIOLATION"]
        },
        "recoverability": {
          "type": "string",
          "enum": ["PRECOMMIT_REPAIR", "OBSERVE_ONLY", "POSTCOMMIT_RECOVERY", "HUMAN_INTERLOCK", "NONE"]
        },
        "observability": {
          "type": "string",
          "enum": ["UNOBSERVED", "FRESH_COMPLETE", "FRESH_PARTIAL", "STALE", "LOST", "CONTRADICTORY"]
        },
        "message_capability": {
          "type": "string",
          "enum": ["AVAILABLE", "RESERVED", "SEALED"]
        },
        "failure": { "$ref": "#/$defs/transport_failure" },
        "provider_user_message_count": { "type": "integer", "enum": [0, 1] },
        "send_activation_count": { "type": "integer", "enum": [0, 1] },
        "user_message_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "assistant_message_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "archive_ref": { "$ref": "#/$defs/nullable_ref" },
        "handoff_ref": { "$ref": "#/$defs/nullable_ref" }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "chatgpt" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "product_model": { "const": "GPT-5.6 Sol" },
              "reasoning_effort": { "const": "Pro" }
            }
          },
          "else": {
            "properties": {
              "reasoning_effort": { "type": "null" }
            }
          }
        }
      ]
    },
    "clerk_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job_id", "operation", "outcome", "observations"],
      "properties": {
        "kind": { "const": "clerk" },
        "job_id": { "$ref": "#/$defs/id" },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "outcome": {
          "type": "string",
          "enum": ["COMPLETED", "REFUSED", "UNKNOWN"]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "artifact_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "paths", "sha256_by_path"],
      "properties": {
        "kind": { "const": "artifact" },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "sha256_by_path": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "recovery_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "failure_class", "observed_refs", "attempts", "outcome", "resume_condition"],
      "properties": {
        "kind": { "const": "recovery" },
        "failure_class": { "type": "string", "minLength": 1 },
        "observed_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "attempts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "outcome": { "type": "string", "minLength": 1 },
        "resume_condition": { "$ref": "#/$defs/nullable_ref" }
      }
    }
  }
}
