{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_runtime_browser_assignments",
  "title": "HMASD runtime BrowserTransport assignment map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "writer", "assignments"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "const": "Root" },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "epoch_milliseconds": {
      "type": "integer",
      "minimum": 1
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ref": {
      "anyOf": [
        { "$ref": "#/$defs/content_ref" },
        { "type": "string", "minLength": 1, "maxLength": 512 }
      ]
    },
    "nullable_ref": {
      "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "transport_identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "nullable_transport_identity": {
      "anyOf": [{ "$ref": "#/$defs/transport_identity" }, { "type": "null" }]
    },
    "requester_identity": {
      "type": "string",
      "pattern": "^(?:Root|EM-[a-z0-9][a-z0-9_-]{1,63}|CM-[a-z0-9][a-z0-9_-]{1,63})$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "projection", "verified_at"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "projection": { "const": "exact" },
        "verified_at": { "type": "integer", "minimum": 1 }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "browser_identity",
        "requester_identity",
        "request_ref",
        "direction_id",
        "mode",
        "effect_ref",
        "paused",
        "provider",
        "product_model",
        "reasoning_effort",
        "target_conversation_url",
        "target_conversation_id",
        "prompt_ref",
        "response_path",
        "operation_id",
        "idempotency_key",
        "request_fingerprint",
        "stable_key",
        "operation_ref",
        "created_at",
        "updated_at",
        "send_attempted",
        "send_attempted_at",
        "observed_conversation_url",
        "observed_conversation_id",
        "provider_user_message_id",
        "provider_assistant_message_id",
        "archive",
        "error"
      ],
      "properties": {
        "assignment_id": { "$ref": "#/$defs/id" },
        "browser_identity": { "type": "string", "const": "BrowserTransport" },
        "requester_identity": { "$ref": "#/$defs/requester_identity" },
        "request_ref": { "$ref": "#/$defs/ref" },
        "direction_id": {
          "anyOf": [{ "$ref": "#/$defs/direction_id" }, { "type": "null" }]
        },
        "mode": {
          "type": "string",
          "enum": ["INNOVATOR", "CONVERGENCE", "DIVERGENT", "ENGINEERING", "MONITOR"]
        },
        "effect_ref": { "$ref": "#/$defs/nullable_ref" },
        "paused": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["chatgpt", "gemini"] },
        "product_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reasoning_effort": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "target_conversation_url": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 2048 }, { "type": "null" }]
        },
        "target_conversation_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "prompt_ref": { "$ref": "#/$defs/content_ref" },
        "response_path": { "$ref": "#/$defs/path" },
        "operation_id": { "$ref": "#/$defs/transport_identity" },
        "idempotency_key": { "$ref": "#/$defs/transport_identity" },
        "request_fingerprint": { "$ref": "#/$defs/sha256" },
        "stable_key": { "$ref": "#/$defs/transport_identity" },
        "operation_ref": { "$ref": "#/$defs/ref" },
        "created_at": { "$ref": "#/$defs/epoch_milliseconds" },
        "updated_at": { "$ref": "#/$defs/epoch_milliseconds" },
        "send_attempted": { "type": "boolean" },
        "send_attempted_at": {
          "anyOf": [{ "$ref": "#/$defs/epoch_milliseconds" }, { "type": "null" }]
        },
        "observed_conversation_url": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 2048 }, { "type": "null" }]
        },
        "observed_conversation_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "provider_user_message_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "provider_assistant_message_id": { "$ref": "#/$defs/nullable_transport_identity" },
        "archive": {
          "anyOf": [{ "$ref": "#/$defs/archive" }, { "type": "null" }]
        },
        "error": {
          "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "chatgpt" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "product_model": { "const": "GPT-5.6 Sol" },
              "reasoning_effort": { "const": "Pro" }
            }
          },
          "else": { "properties": { "reasoning_effort": { "type": "null" } } }
        },
        {
          "if": { "properties": { "send_attempted": { "const": false } }, "required": ["send_attempted"] },
          "then": { "properties": { "send_attempted_at": { "type": "null" } } },
          "else": { "properties": { "send_attempted_at": { "$ref": "#/$defs/epoch_milliseconds" } } }
        },
        {
          "if": { "properties": { "provider_user_message_id": { "type": "string" } }, "required": ["provider_user_message_id"] },
          "then": { "properties": { "send_attempted": { "const": true } } }
        },
        {
          "if": { "properties": { "provider_assistant_message_id": { "type": "string" } }, "required": ["provider_assistant_message_id"] },
          "then": { "properties": { "provider_user_message_id": { "type": "string" } } }
        },
        {
          "if": { "properties": { "archive": { "type": "object" } }, "required": ["archive"] },
          "then": { "properties": { "provider_assistant_message_id": { "type": "string" } } }
        }
      ]
    }
  }
}
