{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_operator_result_v2",
  "title": "HMASD v2 Experiment Operator terminal result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_message_id",
    "run_id",
    "operator_identity",
    "manifest_ref",
    "stdout_ref",
    "stderr_ref",
    "terminal_status",
    "exit_code"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "assignment_message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "operator_identity": {
      "type": "string",
      "pattern": "^Operator-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "manifest_ref": { "$ref": "#/$defs/file_ref" },
    "stdout_ref": { "$ref": "#/$defs/file_ref" },
    "stderr_ref": { "$ref": "#/$defs/file_ref" },
    "terminal_status": {
      "type": "string",
      "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]
    },
    "exit_code": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!.*:)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![^/]*[. ](?:/|$))(?!.*\\/[^/]*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
