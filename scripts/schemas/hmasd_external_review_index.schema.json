{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_external_review_index",
  "title": "HMASD external review index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "writer",
    "direction_id",
    "workflow_version",
    "rounds"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 4 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "pattern": "^EM-[a-z0-9][a-z0-9_-]{1,63}$" },
    "direction_id": { "$ref": "#/$defs/direction_id" },
    "workflow_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "round_id": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
    "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullable_ref": {
      "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }]
    },
    "nullable_transport_ref": {
      "anyOf": [
        { "$ref": "#/$defs/ref" },
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    },
    "nullable_identity": {
      "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locus", "code"],
      "properties": {
        "locus": {
          "type": "string",
          "enum": ["NONE", "SPEC", "AUTH", "TAB_OWNERSHIP", "PRECOMMIT_UI", "COMMIT_BOUNDARY", "TURN_CONFIRMATION", "RESPONSE", "ARCHIVE"]
        },
        "code": { "type": "string", "pattern": "^(?:NONE|[A-Z][A-Z0-9_]{0,127})$" }
      }
    },
    "provider_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "product_model",
        "reasoning_effort",
        "operation_id",
        "idempotency_key",
        "operation_ref",
        "provider_conversation_ref",
        "provider_conversation_id",
        "phase",
        "commitment",
        "recoverability",
        "observability",
        "message_capability",
        "failure",
        "provider_user_message_count",
        "send_activation_count",
        "user_message_id",
        "assistant_message_id",
        "archive_ref",
        "handoff_ref",
        "completed_at"
      ],
      "properties": {
        "provider": { "type": "string", "enum": ["chatgpt", "gemini"] },
        "product_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reasoning_effort": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "operation_id": { "$ref": "#/$defs/identity" },
        "idempotency_key": { "$ref": "#/$defs/identity" },
        "operation_ref": { "$ref": "#/$defs/ref" },
        "provider_conversation_ref": { "$ref": "#/$defs/nullable_transport_ref" },
        "provider_conversation_id": { "$ref": "#/$defs/nullable_identity" },
        "phase": {
          "type": "string",
          "enum": ["VALIDATE", "PREPARE_UI", "ARMED", "VERIFY_COMMITMENT", "WAIT_RESPONSE", "READ_RESPONSE", "PUBLISH_ARCHIVE", "TERMINAL"]
        },
        "commitment": {
          "type": "string",
          "enum": ["ZERO_PROVEN", "UNRESOLVED", "ONE_EXACT", "VIOLATION"]
        },
        "recoverability": {
          "type": "string",
          "enum": ["PRECOMMIT_REPAIR", "OBSERVE_ONLY", "POSTCOMMIT_RECOVERY", "HUMAN_INTERLOCK", "NONE"]
        },
        "observability": {
          "type": "string",
          "enum": ["UNOBSERVED", "FRESH_COMPLETE", "FRESH_PARTIAL", "STALE", "LOST", "CONTRADICTORY"]
        },
        "message_capability": {
          "type": "string",
          "enum": ["AVAILABLE", "RESERVED", "SEALED"]
        },
        "failure": { "$ref": "#/$defs/failure" },
        "provider_user_message_count": { "type": "integer", "enum": [0, 1] },
        "send_activation_count": { "type": "integer", "enum": [0, 1] },
        "user_message_id": { "$ref": "#/$defs/nullable_identity" },
        "assistant_message_id": { "$ref": "#/$defs/nullable_identity" },
        "archive_ref": { "$ref": "#/$defs/nullable_ref" },
        "handoff_ref": { "$ref": "#/$defs/nullable_ref" },
        "completed_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "chatgpt" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "product_model": { "const": "GPT-5.6 Sol" },
              "reasoning_effort": { "const": "Pro" }
            }
          },
          "else": {
            "properties": {
              "reasoning_effort": { "type": "null" }
            }
          }
        }
      ]
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_id",
        "question_sha256",
        "evidence_set_sha256",
        "status",
        "prompt_refs",
        "providers",
        "local_synthesis_ref",
        "created_at",
        "completed_at"
      ],
      "properties": {
        "round_id": { "$ref": "#/$defs/round_id" },
        "question_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_set_sha256": { "$ref": "#/$defs/sha256" },
        "status": {
          "type": "string",
          "enum": [
            "INNOVATOR_PENDING",
            "INNOVATOR_RUNNING",
            "LOCAL_RESEARCH",
            "SYNTHESIS_READY",
            "CONVERGENCE_RUNNING",
            "COMPLETE",
            "BLOCKED"
          ]
        },
        "prompt_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pro_innovator", "pro_convergence"],
          "properties": {
            "pro_innovator": { "$ref": "#/$defs/ref" },
            "pro_convergence": { "$ref": "#/$defs/nullable_ref" }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pro_innovator", "pro_convergence"],
          "properties": {
            "pro_innovator": { "anyOf": [{ "$ref": "#/$defs/provider_result" }, { "type": "null" }] },
            "pro_convergence": { "anyOf": [{ "$ref": "#/$defs/provider_result" }, { "type": "null" }] }
          }
        },
        "local_synthesis_ref": { "$ref": "#/$defs/nullable_ref" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    }
  }
}
