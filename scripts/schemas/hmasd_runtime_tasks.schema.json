{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_runtime_tasks",
  "title": "HMASD Codex runtime task registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "writer", "tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "const": "Root" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "direction_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_identity", "kind", "generation", "task_title", "lifecycle"],
      "properties": {
        "logical_identity": { "$ref": "#/$defs/identity" },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "direction_id": {
          "anyOf": [{ "$ref": "#/$defs/direction_id" }, { "type": "null" }]
        },
        "generation": { "type": "integer", "minimum": 1 },
        "task_title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "thread_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "host_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "last_cursor": { "anyOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] },
        "project_root": { "anyOf": [{ "$ref": "#/$defs/absolute_path" }, { "type": "null" }] },
        "parent_identity": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "worktree_ref": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "checkpoint_sha": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "lifecycle": {
          "type": "string",
          "enum": ["CREATED", "RUNNING", "ACTIVE", "PARKED", "IDLE", "COMPLETED", "FAILED", "RETIRED", "UNKNOWN"]
        },
        "last_seen_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
