{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_external_archive",
  "title": "Agentify natural completion archive (foreign schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operationId",
    "idempotencyKey",
    "stableKey",
    "provider",
    "model",
    "conversationUrl",
    "conversationId",
    "terminalState",
    "sendCount",
    "sendActionCount",
    "userMessageId",
    "assistantMessageId",
    "responseSha256",
    "responseText",
    "completedAt"
  ],
  "properties": {
    "schema": { "const": "agentify_review_natural_completion_archive_v1" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "stableKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "enum": ["chatgpt", "gemini"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "conversationUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "conversationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "terminalState": { "const": "NATURAL_COMPLETION_VERIFIED" },
    "sendCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "sendActionCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "userMessageId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "assistantMessageId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "responseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "responseText": { "type": "string" },
    "completedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "chatgpt" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "conversationUrl": {
            "pattern": "^https://chatgpt\\.com/c/[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "gemini" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "conversationUrl": {
            "pattern": "^https://gemini\\.google\\.com/app/[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          }
        }
      }
    }
  ]
}
