{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_run_manifest",
  "title": "HMASD local run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "writer",
    "run_id",
    "direction_id",
    "assignment_id",
    "operator_identity",
    "status",
    "command",
    "command_sha256",
    "cwd",
    "parameters",
    "code_sha",
    "environment",
    "estimate",
    "resources",
    "process",
    "outputs",
    "observed_metrics",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "writer": { "type": "string", "pattern": "^Operator-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "run_id": { "$ref": "#/$defs/id" },
    "direction_id": { "$ref": "#/$defs/direction_id" },
    "assignment_id": { "$ref": "#/$defs/assignment_id" },
    "operator_identity": { "type": "string", "pattern": "^Operator-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": {
      "type": "string",
      "enum": ["PREPARED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "command_sha256": { "$ref": "#/$defs/sha256" },
    "claim_sha256": { "$ref": "#/$defs/sha256" },
    "cwd": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$" },
    "parameters": { "type": "object", "additionalProperties": true },
    "parameters_sha256": { "$ref": "#/$defs/sha256" },
    "code_sha": { "$ref": "#/$defs/git_sha" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "hostname", "captured_variables"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
        "captured_variables": { "type": "object", "additionalProperties": true }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "basis", "peak_memory_gib"],
      "properties": {
        "wall_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "peak_memory_gib": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_ref", "workers", "threads_per_worker", "memory_safe"],
      "properties": {
        "preflight_ref": { "$ref": "#/$defs/relative_path" },
        "preflight_sha256": { "$ref": "#/$defs/sha256" },
        "runner_spec_sha256": { "$ref": "#/$defs/sha256" },
        "workers": { "type": "integer", "minimum": 1 },
        "threads_per_worker": { "type": "integer", "minimum": 1 },
        "memory_safe": { "type": "boolean" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_token",
        "pid",
        "process_group_id",
        "linux_boot_id",
        "proc_start_ticks",
        "started_at",
        "ended_at",
        "exit_code",
        "terminal_reason"
      ],
      "properties": {
        "execution_token": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }]
        },
        "pid": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "process_group_id": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "linux_boot_id": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "proc_start_ticks": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "identity_persisted_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "group_quiescent": {
          "anyOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "started_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "ended_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "exit_code": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "terminal_reason": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr", "checkpoints", "metrics", "artifacts"],
      "properties": {
        "stdout": { "$ref": "#/$defs/relative_path" },
        "stderr": { "$ref": "#/$defs/relative_path" },
        "checkpoints": { "$ref": "#/$defs/relative_path" },
        "metrics": { "$ref": "#/$defs/relative_path" },
        "artifacts": { "$ref": "#/$defs/relative_path" }
      }
    },
    "observed_metrics": { "type": "object", "additionalProperties": true },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
