{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmasd_accepted_result",
  "title": "HMASD accepted result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "writer",
    "result_id",
    "direction_id",
    "conclusion_path",
    "source_run",
    "metrics",
    "promoted_at",
    "promoted_by"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "writer": { "type": "string", "pattern": "^EM-[a-z0-9][a-z0-9_-]{1,63}$" },
    "result_id": { "$ref": "#/$defs/id" },
    "direction_id": { "$ref": "#/$defs/direction_id" },
    "conclusion_path": { "$ref": "#/$defs/path" },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "manifest_path",
        "manifest_sha256",
        "code_sha",
        "parameters",
        "parameters_sha256"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "manifest_path": { "$ref": "#/$defs/path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "code_sha": { "$ref": "#/$defs/git_sha" },
        "parameters": { "type": "object", "additionalProperties": true },
        "parameters_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/metric" }
    },
    "promoted_at": { "$ref": "#/$defs/timestamp" },
    "promoted_by": { "type": "string", "pattern": "^EM-[a-z0-9][a-z0-9_-]{1,63}$" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "direction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "split", "aggregation", "sample_count"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "split": { "type": "string", "minLength": 1, "maxLength": 64 },
        "aggregation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sample_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
