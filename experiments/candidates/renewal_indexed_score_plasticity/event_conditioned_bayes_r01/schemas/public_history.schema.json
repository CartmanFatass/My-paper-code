{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RISP-ECR-R01-PUBLIC-HISTORY-V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "history_id", "binding_class", "initial_belief", "events", "decision"],
  "properties": {
    "schema": {"const": "RISP-ECR-R01-PUBLIC-HISTORY-V1"},
    "history_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Z0-9_]+$"},
    "binding_class": {"enum": ["REGISTERED", "TEST_ONLY"]},
    "initial_belief": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/rational"}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/event"}
    },
    "decision": {"$ref": "#/$defs/decision"}
  },
  "$defs": {
    "rational": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer", "minimum": 1}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renewal_index", "primitive_start", "primitive_end", "completed_duration",
        "action", "ack", "action_event_index", "hold_completion_event_index",
        "motion_event_index", "ack_event_index", "private_update_event_index"
      ],
      "properties": {
        "renewal_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "primitive_start": {"type": "integer", "minimum": 0},
        "primitive_end": {"type": "integer", "minimum": 1},
        "completed_duration": {"enum": [4, 8, 12]},
        "action": {"enum": ["LEFT", "CENTER", "RIGHT"]},
        "ack": {"enum": ["+", "-"]},
        "action_event_index": {"type": "integer", "minimum": 0},
        "hold_completion_event_index": {"type": "integer", "minimum": 1},
        "motion_event_index": {"type": "integer", "minimum": 2},
        "ack_event_index": {"type": "integer", "minimum": 3},
        "private_update_event_index": {"type": "integer", "minimum": 4}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renewal_index", "primitive_time", "next_duration", "next_action_event_index", "next_hold_credit"],
      "properties": {
        "renewal_index": {"type": "integer", "minimum": 1, "maximum": 8},
        "primitive_time": {"type": "integer", "minimum": 1},
        "next_duration": {"enum": [4, 8, 12]},
        "next_action_event_index": {"type": "integer", "minimum": 5},
        "next_hold_credit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primitive_start", "primitive_end"],
          "properties": {
            "primitive_start": {"type": "integer", "minimum": 1},
            "primitive_end": {"type": "integer", "minimum": 2}
          }
        }
      }
    }
  }
}
