{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmasd.local/schemas/cbsc_host_spec_v1.schema.json",
  "title": "CBSC exact factorial host specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "direction_id", "protocol_id", "nuisance_version", "owner_levels", "semantic_levels", "binding_levels", "access_levels", "payload_levels", "policies", "actions", "nuisance_fields", "costs", "material_margin", "protocol_order", "all_payload_issuance_law", "phase_currentness_law", "reassociation_law", "authorization_information_law", "action_clock_law", "determinism_law", "publication_law", "branch_order", "cbsc_fixed_rule", "owner_blind_law", "reset_law", "hard_open_law", "policy_capability_law", "action_ledger_incidence", "contrast_laws", "delta_comparator", "branch_witness_law", "interpretation_boundary"],
  "properties": {
    "schema": {"const": "cbsc_host_spec_v1"},
    "direction_id": {"const": "capability_bound_semantic_currentness"},
    "protocol_id": {"const": "CBSC-EXACT-FACTORIAL-V1"},
    "nuisance_version": {"const": "CBSC-F0-V1"},
    "owner_levels": {"const": ["LIVE", "BROKEN"]},
    "semantic_levels": {"const": ["PERSIST", "REFRESH"]},
    "binding_levels": {"const": ["AUTHENTIC", "WHOLE_CARRIER_REASSOCIATED"]},
    "access_levels": {"const": ["OPEN", "BINDING_GATED"]},
    "payload_levels": {"const": ["RECEIVER_CORRECT", "SWAPPED", "NATIVE_NEUTRAL"]},
    "policies": {"const": ["CBSC_RULE", "RAW_EXACT_OPTIMUM", "OWNER_BLIND_OPTIMUM", "PREDICTIVE_INDEX_CAPABILITY_NULL", "RESET_EXACT", "HARD_OPEN"]},
    "actions": {"const": ["SERVE", "REFRESH", "SAFE_FALLBACK"]},
    "nuisance_fields": {"const": ["physical_receiver", "old_bit", "current_bit", "donor_bit", "z0", "z1", "presentation_permutation"]},
    "costs": {"const": [["common_validation_read", [1, 8]], ["padded_terminal_service_actuation", [1, 8]], ["refresh_scan", [1, 4]], ["refresh_delay", [1, 4]], ["new_content_ingestion", [1, 8]], ["gross_correct_service", [1, 1]], ["gross_wrong_service", [-1, 1]], ["gross_unauthorized_attempt", [-1, 2]], ["gross_safe_fallback", [0, 1]]]},
    "material_margin": {"const": [1, 4]},
    "protocol_order": {"const": ["COMMIT_NEED_RECEIVER_OLD_CONTENT_PHASE", "ISSUE_ALL_IMMUTABLE_BODIES_AND_WHOLE_CARRIERS", "COMMIT_OWNER_AND_SEMANTIC_EPOCH", "COMMIT_ACCESS_LAW", "CHOOSE_ONCE_AT_T0_WITHOUT_AUTHORIZATION_RESULT", "TERMINATE_T0_OR_REFRESH_AND_CORRECT_SERVICE_T1"]},
    "all_payload_issuance_law": {"const": "CORRECT_SWAPPED_NEUTRAL_IMMUTABLE_INVENTORY_BEFORE_PAYLOAD_SELECTION"},
    "phase_currentness_law": {"const": "RECEIVER_KEYED_BASE_BIT_XOR_PUBLIC_Z;_REFRESH_MISMATCH_HIDES_NEW_CONTENT_UNTIL_T1"},
    "reassociation_law": {"const": "FIXED_POINT_FREE_SWAP_OF_INTACT_CARRIERS_WITHIN_PRETREATMENT_STRATUM"},
    "authorization_information_law": {"const": "NO_PREACTION_RESULT;GATED_REQUIRES_LIVE_OWNER_AUTHENTIC_ASSOCIATION_RECEIVER_ADDRESSED_NONNEUTRAL_BODY;OPEN_REMOVES_EDGE;INDEX_NULL_MATCHES_OPEN"},
    "action_clock_law": {"const": [["SERVE", 0], ["SAFE_FALLBACK", 0], ["REFRESH", 1]]},
    "determinism_law": {"const": ["EXHAUSTIVE_FACTORS_AND_NUISANCE", "CBSC_F0_V1_COUNTER_ADDRESSED_NUISANCE_ONLY", "NO_GLOBAL_PYTHON_NUMPY_TORCH_RNG", "CANONICAL_WORLD_THEN_POLICY_ROW_ORDER", "ZERO_OPTIMIZER_SEEDS_CHECKPOINTS"]},
    "publication_law": {"const": ["COMPLETE_ONLY", "ATOMIC", "CREATE_ONLY", "REJECT_PREEXISTING_TARGET"]},
    "branch_order": {"const": ["VALID_NARROW_PROTOCOL_VALUE", "INDEX_ABSORBS", "RAW_MISMATCH_OR_TIE", "NO_CAPABILITY_EDGE", "NO_CONTENT_EDGE", "INVALID"]},
    "cbsc_fixed_rule": {"const": [["FOCAL_NEED_INACTIVE", "SAFE_FALLBACK"], ["DIRECT_EXECUTABLE_AND_CURRENT_AND_RECEIVER_SOURCE_CORRECT", "SERVE"], ["OTHERWISE", "REFRESH"]]},
    "owner_blind_law": {"const": ["MASK_OWNER_PREDECESSOR_HISTORY", "OPTIMIZE_UNIFORM_LIVE_BROKEN_MIXTURE"]},
    "reset_law": {"const": ["REMOVE_ALL_CACHED_BODY_AND_CARRIER_FIELDS", "KEEP_PUBLIC_FOCAL_NEED_ACTIVE", "WAIVE_COMMON_VALIDATION_READ_ONLY", "SINGLE_REACTIVE_REFRESH"]},
    "hard_open_law": {"const": ["FIXED_NOT_OPTIMIZED", "ACTIVE_NEED_SERVE_CACHED_BODY", "INACTIVE_NEED_SAFE_FALLBACK", "NO_CURRENTNESS_OR_ADDRESS_CONDITIONING"]},
    "policy_capability_law": {"const": [["CBSC_RULE", "OPEN_ROUTED_OR_GATED_CURRENT_NONFUNGIBLE_CAPABILITY"], ["RAW_EXACT_OPTIMUM", "SAME_CAPABILITY_AND_PRIMITIVES_AS_CBSC"], ["OWNER_BLIND_OPTIMUM", "SAME_CAPABILITY_WITH_OWNER_MASK"], ["PREDICTIVE_INDEX_CAPABILITY_NULL", "OPEN_EQUIVALENT_GATED_NO_NONFUNGIBLE_DIRECT_CAPABILITY"], ["RESET_EXACT", "NO_CACHED_DIRECT_CAPABILITY"], ["HARD_OPEN", "DIAGNOSTIC_FIXED_CACHED_BODY_USE"]]},
    "action_ledger_incidence": {"const": [["SERVE", ["COMMON_READ_UNLESS_RESET_T0", "ONE_OF_CORRECT_WRONG_UNAUTHORIZED_GROSS_T0", "PADDED_TERMINAL_ACTUATION_T0"]], ["SAFE_FALLBACK", ["COMMON_READ_UNLESS_RESET_T0", "ZERO_GROSS_T0", "PADDED_TERMINAL_ACTUATION_T0"]], ["REFRESH", ["COMMON_READ_UNLESS_RESET_T0", "SCAN_T0", "DELAY_T0", "INGESTION_T1", "ACTIVE_CORRECT_OR_INACTIVE_ZERO_GROSS_T1", "PADDED_TERMINAL_ACTUATION_T1"]]]},
    "contrast_laws": {"const": [["CAPABILITY_DID", "(CBSC-INDEX)_GATED_USABLE-(CBSC-INDEX)_OPEN_USABLE"], ["OWNER_INFORMATION", "MEAN_LIVE_BROKEN(CBSC-OWNER_BLIND)_GATED_AUTHENTIC_CORRECT_PERSIST"], ["RETAINED_CONTENT", "CBSC-RESET_GATED_LIVE_AUTHENTIC_CORRECT_PERSIST"], ["CURRENTNESS", "CBSC_PERSIST-CBSC_REFRESH_GATED_LIVE_AUTHENTIC_CORRECT"], ["CORRECT_VS_SWAPPED", "CBSC_CORRECT-CBSC_SWAPPED_GATED_LIVE_AUTHENTIC_PERSIST"]]},
    "delta_comparator": {"const": "NAMED_FIVE_CONTRAST_ACCEPT_IF_GREATER_THAN_OR_EQUAL_TO_MATERIAL_MARGIN;ACTION_GAPS_STRICTLY_POSITIVE_ONLY"},
    "branch_witness_law": {"const": "REGISTERED_PRECEDENCE;FIRST_FALSE_AUDIT;CANONICAL_WORLD_OR_PAIR_FOR_ROWWISE_FAILURE"},
    "interpretation_boundary": {"const": "Exact one-opportunity protocol value of current receiver-addressed content plus a current execution capability only; no representation, learning, security, proactive acquisition, MARL, variable-population/lifetime, UAV, safety, or deployment claim."}
  },
  "$defs": {
    "rational": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2}
  }
}
