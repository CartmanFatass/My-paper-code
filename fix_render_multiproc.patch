# 修复多进程评估中的渲染问题
# 
# 问题原因：
# 1. 评估时使用 SubprocVecEnv，环境在子进程中运行
# 2. 环境的 render_mode 已设置为 "rgb_array"
# 3. 但 scenario4_discrete.py 的 _render_frame() 方法可能在子进程中遇到matplotlib后端问题
#
# 解决方案：
# 在 scenario4_discrete.py 的 _render_frame() 方法开始处，添加进程检测和matplotlib后端配置

--- a/envs/pettingzoo/scenario4_discrete.py
+++ b/envs/pettingzoo/scenario4_discrete.py
@@ -行号,6 +行号,25 @@
     def _render_frame(self):
         """
         渲染单帧 - 增强版2D视图
-        【多进程修复版】: 移除环境内的后端检测，依赖训练脚本进行设置
+        【多进程修复版v2】: 在每次渲染前确保matplotlib后端正确配置
         """
+        import os
+        import multiprocessing
+        
+        # 【关键修复】在子进程中，每次渲染前都重新确认后端设置
+        # 这解决了 SubprocVecEnv 子进程中的渲染问题
+        try:
+            import matplotlib
+            current_backend = matplotlib.get_backend()
+            
+            # 如果当前后端不是Agg，强制切换
+            if current_backend != 'agg':
+                matplotlib.use('Agg', force=True)
+                print(f"[PID: {os.getpid()}] 渲染前切换到Agg后端")
+            
+            import matplotlib.pyplot as plt
+        except Exception as e:
+            print(f"[PID: {os.getpid()}] matplotlib配置失败: {e}")
+            return self._fallback_render_strategy()
+        
         import os
