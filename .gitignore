# .gitignore — ignore generated artifacts and scratch only. Source and documents are visible by
# default; there is no global rule on *.md, *.txt, *.pdf, *.png or test*.py. Layout standard:
# docs/Claude_docs/plans/CODEBASE_LAYOUT_STANDARD_20260903.md. Rules for run output are anchored
# at the repository root so that archived copies under docs/ stay visible.

# Python and tool caches
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db
env/
venv/
.venv/

# Model, result and log output (never versioned; historical logs live under docs/archive/logs/)
/models/
/results/
/logs/
/logs*/
/tf-logs/
/evaluation/
/runtime/
/data/
*.pt
*.pkl
*.npy
*.npz
*.sqlite3
*.tfevents.*
*.log
*.pid
*.csv
*.dat
*.out
/experiments/**/RISP_*_RESUME_*/
/experiments/**/RISP_*_RESULTS_*/
/experiments/**/RISP_*_CHECKPOINTS_*/
/experiments/**/RCLE_*_RESULTS_*/

# Scratch: temp/directions/<direction-id>/{exp,test}/ is the only scratch root
/temp/**
!/temp/README.md
/.tmp*
/tmp/
/scratch/
/.scratch/
/work/
/worktrees/
/.worktrees/
/.cache/
/cache/
/artifacts/
/.charter/cache/
/.omp/runtime/
.pytest_tmp*/
.pytest-*/
.codex_tmp_pytest*/
.tmp_pytest*/
tmp_pytest*/
pytest_tmp*/
/temp_*.json
debug/
temp_collection_log/
/local_research/

# Agent runtime state (agent definitions and settings are tracked; worktrees and locks are not)
/.claude/worktrees/
/.claude/*.lock
/.remember/
/.codex/runtime/

# Owner's personal notes
/docs/personal/

# Archives and large binaries
ref/hmasd/
ref/OPT-main/
*.tar
!ref/hmasd.tar
*.zip
*.gz
*.doc
*.docx
