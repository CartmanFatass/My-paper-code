{
  "schema_version": 20,
  "updated": "2026-07-20",
  "review_manager": {
    "kind": "persistent_full_round_manager",
    "title": "External Review Manager",
    "session_role_registry": ".agents/skills/hmasd-task-router/references/session-roles.json",
    "controller_messages": [
      "START_REVIEW"
    ],
    "manager_messages": [
      "REVIEW_GIT_PUSH_REQUIRED",
      "REVIEW_COMPLETE",
      "REVIEW_BLOCKED"
    ],
    "exchange_messages": {
      "manager_to_exchange": "REVIEW_STAGE",
      "exchange_to_manager": [
        "REVIEW_STAGE_COMPLETE",
        "REVIEW_STAGE_BLOCKED"
      ]
    },
    "owns": [
      "reviewer_stage_dispatch",
      "active_round_questions",
      "raw_acceptance",
      "evidence_reconciliation",
      "final_disposition",
      "exact_git_boundary_request"
    ],
    "git_boundary": {
      "manager_role": "report_exact_active_round_paths_only",
      "controller_role": "inspect_commit_push_then_restart_same_manager"
    }
  },
  "exchange_contract": {
    "role_skill": ".agents/skills/hmasd-review-exchange/SKILL.md",
    "one_reviewer_per_session": true,
    "controller_contact": "forbidden",
    "browser": {
      "surface": "codex_in_app_browser",
      "ui_scope": "application_shared",
      "logical_owner": "registered_pro_exchange",
      "foreground_policy": "navigate_to_own_exchange_before_browser_operation"
    },
    "heartbeat": {
      "kind": "heartbeat",
      "name_template": "hmasd-review-<round>-<stage>",
      "owner": "registered_reviewer_exchange_session",
      "target": "self",
      "interval_minutes": 5,
      "active_condition": "one accepted external response or manager callback is pending",
      "terminal_order": "validate_raw_then_confirm_manager_callback_then_delete",
      "duplicate_policy": "same_handoff_id_is_idempotent"
    }
  },
  "reviewers": {
