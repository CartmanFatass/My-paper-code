{
  "description": "HMASD workspace boundary and Code Project Manager acceptance guards.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(shell_command|Bash|unified_exec|exec_command|apply_patch|ApplyPatch)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/fires/.conda/envs/hmasd-amd-cpu/python.exe\" scripts/hmasd_workspace_boundary_guard.py",
            "timeout": 5,
            "statusMessage": "Enforcing the HMASD workspace boundary"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/fires/.conda/envs/hmasd-amd-cpu/python.exe\" .agents/skills/hmasd-agile-research-development/scripts/hmasd_execution_readiness.py hook-stop",
            "timeout": 10,
            "statusMessage": "Checking HMASD Code PM acceptance"
          }
        ]
      }
    ]
  }
}
