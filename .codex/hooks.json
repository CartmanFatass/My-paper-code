{
  "description": "HMASD routing and Code Project Manager acceptance guards.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^codex_app__send_message_to_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/fires/.conda/envs/hmasd-amd-cpu/python.exe\" .agents/skills/hmasd-cross-task-routing/scripts/hmasd_cross_task_route_guard.py",
            "timeout": 5,
            "statusMessage": "Preserving HMASD target task settings"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/fires/.conda/envs/hmasd-amd-cpu/python.exe\" .agents/skills/hmasd-agile-research-development/scripts/hmasd_execution_readiness.py hook-stop",
            "timeout": 10,
            "statusMessage": "Checking HMASD Code PM acceptance"
          }
        ]
      }
    ]
  }
}
