{
  "schema_version": 7,
  "updated": "2026-07-20",
  "session_role_registry": ".agents/skills/hmasd-task-router/references/session-roles.json",
  "automation": {
    "kind": "heartbeat",
    "name_template": "hmasd-experiment-<run-id>",
    "owner": "registered_monitor_session",
    "initial_cadence_minutes": 15,
    "minimum_cadence_minutes": 10,
    "target": "self",
    "terminal_action": "delete_after_confirmed_controller_delivery"
  },
  "cadence_policy": {
    "fallback_minutes": 15,
    "minimum_progress_fraction": 0.05,
    "relax_hysteresis_multiplier": 1.25,
    "eta_buckets": [
      {"eta_minutes_above": 240, "interval_minutes": 30},
      {"eta_minutes_above": 120, "interval_minutes": 20},
      {"eta_minutes_above": 0, "interval_minutes": 10}
    ]
  },
  "automation_ownership": {
    "create_retarget_and_delete": "registered_monitor_session",
    "controller_role": "communication_only"
  },
  "progress_policy": {
    "display": "monitor_task_each_tick",
    "controller_relay": "terminal_or_actionable_error_only",
    "artifact_scope": "registered_paths_and_fields_only"
  },
  "runtime_state_authority": "Codex automation state and the assigned runner_status.txt"
}
